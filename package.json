{
  "name": "honkai-starrail-cloud-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "A lightweight Windows desktop shell for the official Cloud Star Rail website.",
  "scripts": {
    "dev": "tauri dev",
    "dev:ui": "vite",
    "build": "node scripts/build.mjs",
    "check": "cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -D warnings",
    "format:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "vite": "^7.0.0"
  }
}
